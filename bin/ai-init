#!/usr/bin/env bash
# bin/ai-init — Scaffolds AI agent rules into the current project directory.
#
# Writes CLAUDE.md as the primary output (read by Claude Code CLI).
# Copies to .cursorrules and .github/copilot-instructions.md for compatibility.
#
# Usage:
#   ai-init <language-template-name>
#   ai-init pios --stack <stack-name>
#
# Example:
#   ai-init go
#   ai-init python
#   ai-init nextjs
#   ai-init pios --stack go-api

set -euo pipefail

DOTFILES="$(cd "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")" && pwd)"
BASE_RULES="$DOTFILES/agent-base"
GLOBAL_STD="$BASE_RULES/global/standards.md"

if [ $# -eq 0 ]; then
  echo "Usage: ai-init <language-template>"
  echo "       ai-init pios --stack <stack-name>"
  echo ""
  echo "Available templates:"
  ls -1 "$BASE_RULES/templates" | sed 's/\.md$//'
  exit 1
fi

PIOS_MODE=false
TEMPLATE_NAME=""

if [ "$1" = "pios" ]; then
  PIOS_MODE=true
  if [ "${2:-}" != "--stack" ] || [ -z "${3:-}" ]; then
    echo "Error: pios mode requires a stack. Example: ai-init pios --stack go-api"
    exit 1
  fi
  TEMPLATE_NAME="$3"
else
  TEMPLATE_NAME="$1"
fi

if ! $PIOS_MODE; then
  TEMPLATE_FILE="$BASE_RULES/templates/${TEMPLATE_NAME}.md"

  if [ ! -f "$GLOBAL_STD" ]; then
    echo "Error: Global standards not found at $GLOBAL_STD"
    exit 1
  fi

  if [ ! -f "$TEMPLATE_FILE" ]; then
    echo "Error: No template for '$TEMPLATE_NAME'"
    echo "Available: $(ls -1 "$BASE_RULES/templates" | sed 's/\.md$//' | tr '\n' ' ')"
    exit 1
  fi

  echo "Compiling: global standards + $TEMPLATE_NAME template..."
  {
    cat "$GLOBAL_STD"
    echo ""
    echo "---"
    echo ""
    cat "$TEMPLATE_FILE"
  } > CLAUDE.md

else
  PIOS_RAW_URL="https://raw.githubusercontent.com/cclavin/PIOS/main"

  echo "Fetching PIOS AGENTS.md baseline..."
  if ! curl -fsSL "$PIOS_RAW_URL/AGENTS.md" > CLAUDE.md; then
    echo "Error: Failed to fetch AGENTS.md — is the repo public?"
    exit 1
  fi

  echo "Fetching PIOS stack profile: $TEMPLATE_NAME..."
  {
    echo ""
    echo "---"
    echo ""
    curl -fsSL "$PIOS_RAW_URL/profiles/stacks/${TEMPLATE_NAME}.md" 2>/dev/null \
      || echo "<!-- stack profile '${TEMPLATE_NAME}' not found — add manually -->"
  } >> CLAUDE.md
fi

# Copy to other tools for compatibility
mkdir -p .github
cp CLAUDE.md AGENTS.md
cp CLAUDE.md .cursorrules
cp CLAUDE.md .github/copilot-instructions.md

echo "Done: CLAUDE.md, AGENTS.md written (+ .cursorrules, .github/copilot-instructions.md)"
