# MCP Server Secrets
# ------------------
# Copy this file to mcp/env (gitignored) and fill in values.
# The deploy script (mcp/deploy.py) expands ${VAR} references from these
# environment variables at deploy time.
#
# On macOS/Linux: source this file before running deploy.py
# On Windows:     set each variable via setx (persistent) or $env: (session)
#
# Servers that don't need keys (context7, sequential-thinking, ai-workspace-docs)
# deploy without any env setup.

# -- API keys -----------------------------------------------------------------

# Brave Search — web search MCP (Claude Code only, others have native search)
# Free tier (2K req/month): https://brave.com/search/api/
BRAVE_API_KEY=

# GitHub — repos, issues, PRs, file contents across all your repos
# Create PAT: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Supabase Local — queries your local Supabase instance via built-in MCP endpoint
# Get key: cd <project-dir> && npx supabase status → use the "Secret" value
# Rotates on supabase stop/start — re-run deploy.py --force --server supabase-local
SUPABASE_ACCESS_TOKEN=

# Stripe — customers, subscriptions, invoices, payment intents
# Test-mode key: https://dashboard.stripe.com/test/apikeys (sk_test_...)
STRIPE_SECRET_KEY=

# Exa — neural/semantic web search (Claude Code only)
# Free key: https://dashboard.exa.ai
EXA_API_KEY=

# -- Paths (set in shell profile or here) -------------------------------------

# Full path to the Godot editor executable (Claude Code Godot MCP)
# Windows: C:/Program Files/Godot/Godot_v4.x-stable_win64.exe
# Linux:   /usr/local/bin/godot
GODOT_PATH=

# Root of the Obsidian vault — used by vault-root filesystem MCP
# Windows: C:/Users/<user>/Documents/workspace/vault
# macOS:   /Users/<user>/workspace/vault
# Linux:   /home/<user>/workspace/vault
VAULT_ROOT=

# Root of the AI workspace — used by ai-workspace-docs filesystem MCP
# Windows: G:/ai-workspace
# macOS:   ~/ai-workspace
# Linux:   ~/ai-workspace
AI_WORKSPACE_ROOT=
