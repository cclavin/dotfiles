{
  "_comment": "Claude Code MCP registration. Deploy with: python $AI_WORKSPACE_ROOT/scripts/mcp-deploy.py --tool claude-code",
  "_manage": "Source of truth is servers/*.json. This file lists which servers are registered to Claude Code.",
  "_status": "deployed",
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "ai-workspace-docs": {
      "_note": "Windows-only by default. Set AI_WORKSPACE_ROOT in mcp/env (e.g. G:/ai-workspace/docs). Leave unset on macOS/WSL — server registers but is inert without the path.",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${AI_WORKSPACE_ROOT}"]
    },
    "godot": {
      "_note": "Live config uses hardcoded fnm node path — canonical uses npx. Update live config manually if npx works.",
      "command": "npx",
      "args": ["-y", "@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "${GODOT_PATH}"
      }
    },
    "supabase-local": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "http://127.0.0.1:54321/mcp", "--header", "apikey: ${SUPABASE_ACCESS_TOKEN}"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "vault-root": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${VAULT_ROOT}"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "exa": {
      "_note": "Pending EXA_API_KEY — get free key at dashboard.exa.ai",
      "command": "npx",
      "args": ["-y", "@exa-ai/mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "stripe": {
      "_note": "Use sk_test_ key for dev. Deploy script expands ${STRIPE_SECRET_KEY}.",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.stripe.com",
        "--header",
        "Authorization: Bearer ${STRIPE_SECRET_KEY}"
      ]
    },
    "alpaca": {
      "command": "npx",
      "args": ["-y", "@alpacahq/alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_API_SECRET": "${ALPACA_API_SECRET}",
        "ALPACA_PAPER": "true"
      }
    },
    "plaid": {
      "command": "npx",
      "args": ["-y", "plaid-mcp-server"],
      "env": {
        "PLAID_CLIENT_ID": "${PLAID_CLIENT_ID}",
        "PLAID_SECRET": "${PLAID_SECRET}",
        "PLAID_ENV": "sandbox"
      }
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  }
}
